---
import Player from '../components/Player.jsx';
import { client } from '../lib/sanity.js';

const query = `*[_type == "playlist"][0]{
  tiempoEspera,
  videosMotivacionales[]{
    "type": _type,
    title,
    "videoUrl": videoFile.asset->url
  },
  comerciales[]{
    "type": _type, 
    "_type": _type,
    title,
    "videoUrl": videoFile.asset->url,
    "imageUrl": imageFile.asset->url,
    duration
  }
}`;

const playlistData = await client.fetch(query);
const videos = playlistData?.videosMotivacionales || [];
const comerciales = playlistData?.comerciales || [];
const tiempoEspera = playlistData?.tiempoEspera || 300;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FitGo TV - En Vivo</title>
    <style is:global>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000000;
        }
    </style>
</head>
<body>
    <main class="relative w-full h-full bg-black overflow-hidden z-1">
        <Player 
          videos={videos} 
          comerciales={comerciales} 
          tiempoEspera={tiempoEspera} 
          client:only="react" 
        />
    </main>
</body>
</html>